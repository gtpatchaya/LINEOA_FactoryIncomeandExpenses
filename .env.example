# ---------- Server ----------
PORT=3000
# URL สาธารณะของเซิร์ฟเวอร์ (ใช้แสดงในหน้าแอดมิน เช่น Webhook URL)
PUBLIC_BASE_URL=https://your-domain.example.com

# ---------- LINE ----------
# LIFF ID (LINE Developers > LINE Login channel > LIFF)
LIFF_ID=
# Channel ID ของ LINE Login channel ที่ผูกกับ LIFF (ใช้ verify ID token)
LINE_LOGIN_CHANNEL_ID=
# Messaging API channel ของ LINE OA
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ---------- Firestore ----------
# memory = เก็บในหน่วยความจำ (ไว้ทดสอบ) | firestore = ใช้งานจริง
STORE=firestore
FIREBASE_PROJECT_ID=
# เลือกอย่างใดอย่างหนึ่ง:
# 1) ใส่ JSON ของ service account ทั้งก้อน (บรรทัดเดียว)
FIREBASE_SERVICE_ACCOUNT_JSON=
# 2) หรือระบุ path ไฟล์ service account
GOOGLE_APPLICATION_CREDENTIALS=

# ---------- หลังบ้าน (Admin) ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# สตริงสุ่มยาวๆ ใช้เซ็น session ของแอดมิน
SESSION_SECRET=

# ---------- โหมดพัฒนา ----------
# true = ข้ามการตรวจ LINE token (ใช้ header X-Dev-User) ห้ามเปิดบน production
DEV_AUTH=false
